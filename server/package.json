{
  "name": "flame-server",
  "version": "0.1.0",
  "description": "FLAME platform API (Express)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate && prisma db push --accept-data-loss && node prisma/seed.js",
    "postinstall": "prisma generate",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:functional": "node --test tests/functional.test.mjs",
    "test:concurrency": "node --test tests/concurrency.test.mjs",
    "test:performance": "node --test tests/performance.test.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "images:download": "node scripts/downloadImages.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  }
}
